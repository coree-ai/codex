{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e 'const fs=require(\"node:fs\"),cp=require(\"node:child_process\");const t=process.argv[1],e=process.argv[2],m=process.argv[3]||\"context\";let input=\"\";try{input=fs.readFileSync(0,\"utf8\")}catch{}let r={stdout:\"\"};try{r=cp.spawnSync(\"npx\",[\"--yes\",\"@coree-ai/coree@0.15.0\",\"inject\",\"--type\",t],{input,encoding:\"utf8\",timeout:115000,maxBuffer:1024*1024*8})}catch{}const text=(r.stdout||\"\").trim();if(!text||m===\"empty\"){process.stdout.write(\"{}\")}else{process.stdout.write(JSON.stringify({hookSpecificOutput:{hookEventName:e,additionalContext:text}}))}' session SessionStart",
            "timeout": 120,
            "statusMessage": "Loading coree context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e 'const fs=require(\"node:fs\"),cp=require(\"node:child_process\");const t=process.argv[1],e=process.argv[2],m=process.argv[3]||\"context\";let input=\"\";try{input=fs.readFileSync(0,\"utf8\")}catch{}let r={stdout:\"\"};try{r=cp.spawnSync(\"npx\",[\"--yes\",\"@coree-ai/coree@0.15.0\",\"inject\",\"--type\",t],{input,encoding:\"utf8\",timeout:115000,maxBuffer:1024*1024*8})}catch{}const text=(r.stdout||\"\").trim();if(!text||m===\"empty\"){process.stdout.write(\"{}\")}else{process.stdout.write(JSON.stringify({hookSpecificOutput:{hookEventName:e,additionalContext:text}}))}' prompt UserPromptSubmit",
            "timeout": 120,
            "statusMessage": "Searching coree context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e 'process.stdout.write(\"{}\")'",
            "timeout": 120,
            "statusMessage": "Checking coree memory"
          }
        ]
      }
    ]
  }
}
